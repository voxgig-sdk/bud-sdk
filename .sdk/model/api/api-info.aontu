# API Information


main: {
  kit: {
    info: {
      description: "List and read Bud open-banking financial accounts."
      security: {
        in: "header"
        name: "Authorization"
        prefix: "Bearer"
        scheme: "bearerAuth"
        type: "http"
      }
      servers: [
        {
          url: "https://api-sandbox.thisisbud.com/financial/v2"
        }
      ]
      summary: "List and read Bud open-banking financial accounts."
      title: "Bud Financial Accounts API"
      version: "2.0.0"
      website: "https://thisisbud.com"
    }
  }
}

